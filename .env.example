# Copiez ce fichier en .env.local et remplissez vos propres valeurs pour tester en local.
# Sur Vercel, configurez ces mêmes variables dans Project Settings > Environment Variables.

# Configuration Supabase (comptes clients, contenu du site)
# Project Settings > API dans votre projet Supabase.
# Ces deux valeurs sont publiques par conception (protégées par les règles RLS).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL du site, utilisée pour construire le lien de confirmation d'inscription.
# En local : http://localhost:3000 — en production : https://ohiho.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé API Resend (resend.com > API Keys), pour l'envoi des messages du
# formulaire de contact. Même compte/domaine déjà vérifié pour BugTrack.
RESEND_API_KEY=

# BugTrack (bugtrack.ohiho.fr) : le vrai produit de suivi de tickets, pas
# une table Supabase. site_key généré dans bugtrack.ohiho.fr/admin/sites
# pour l'entrée "ohiho.fr". SANS préfixe NEXT_PUBLIC_ : n'est utilisé que
# côté serveur (Server Actions), jamais exposé au navigateur.
BUGTRACK_API_URL=https://bugtrack.ohiho.fr
BUGTRACK_SITE_KEY=
