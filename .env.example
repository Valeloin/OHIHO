# Copiez ce fichier en .env.local pour tester en local.
# Sur le VPS, le fichier s'appelle .env et vit dans ~/apps/ohiho/ :
# docker-compose.yml le lit au démarrage (voir vps/README.md).

# ---------- Déploiement (VPS uniquement) ----------

# Nom du conteneur : <APP_NAME>-app.
APP_NAME="ohiho"

# Port local écouté par le conteneur, sur 127.0.0.1 uniquement.
# Caddy renvoie ohiho.fr vers ce port. Un port par site : voir le tableau
# de vps/README.md avant d'en choisir un.
APP_PORT="3006"

# ---------- Application ----------

# URL publique du site : liens canoniques, plan du site, données
# structurées. FIGÉE AU BUILD par Next.js (préfixe NEXT_PUBLIC_) : la
# changer oblige à reconstruire l'image Docker.
# En local : http://localhost:3000 — en production : https://ohiho.fr
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clé API Resend (resend.com > API Keys) : envoi des messages du formulaire
# de contact. Le domaine ohiho.fr est déjà vérifié sur ce compte.
# Si la clé est absente, le formulaire bascule automatiquement sur un lien
# mailto: — le site n'est jamais cassé faute de clé.
RESEND_API_KEY=

# Expéditeur des emails du formulaire. Doit être sur un domaine vérifié
# chez Resend, sinon l'envoi est refusé.
EMAIL_FROM="Formulaire OHIHO <contact@ohiho.fr>"

# Destinataire des messages du formulaire.
CONTACT_EMAIL="valentin.condamy@ohiho.fr"

# Mode « site en construction ». Absent ou différent de "false" = le site
# affiche /construction à tous les visiteurs (comportement par défaut, pour
# qu'un oubli referme le site plutôt que de l'ouvrir).
# En local, mettre "false" pour travailler sur le vrai site.
EN_CONSTRUCTION=false
