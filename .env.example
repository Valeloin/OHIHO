# Copiez ce fichier en .env.local et remplissez vos propres valeurs pour tester
# en local. Sur Vercel, configurez ces mêmes variables dans
# Project Settings > Environment Variables.

# URL publique du site, utilisée pour les liens canoniques et le sitemap.
# En local : http://localhost:3000 — en production : https://ohiho.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé API Resend (resend.com > API Keys) : envoi des messages du formulaire
# de contact. Le domaine ohiho.fr est déjà vérifié sur ce compte.
# Si la clé est absente, le formulaire bascule automatiquement sur un lien
# mailto: — le site n'est jamais cassé faute de clé.
RESEND_API_KEY=

# Destinataire des messages du formulaire de contact.
CONTACT_TO=valentin.condamy@ohiho.fr

# Mode « site en construction ». Absent ou différent de "false" = le site
# affiche /construction à tous les visiteurs (comportement par défaut, pour
# qu'un oubli referme le site plutôt que de l'ouvrir).
# En local, mettre "false" pour travailler sur le vrai site.
EN_CONSTRUCTION=false
